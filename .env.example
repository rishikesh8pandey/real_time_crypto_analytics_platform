# PostgreSQL connection for consumer.py and crypto_streaming_processor.ipynb.
# Standard libpq variable names. Set them before running the script or starting Jupyter.
# In PowerShell, for example:
#   $env:PGHOST = "..."
#   $env:PGDATABASE = "..."
#   $env:PGUSER = "..."
#   $env:PGPASSWORD = "..."
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
